// LifeOS Prisma schema
// Postgres for local development and production.
// Use a local Postgres database or a reachable Neon/Supabase branch.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Layer 1: Identity & Vision
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  image         String? // OAuth-provided avatar (separate from user-uploaded `avatarUrl`)
  name          String    @default("Player One")
  class         String    @default("Scholar") // Scholar | Athlete | Artist | Engineer | Connector
  timezone      String    @default("Asia/Shanghai")

  // Profile basics (editable from /settings)
  avatarUrl String? // user-uploaded avatar; falls back to /lifeos/profile_avatar.png
  gender    String? // 男 / 女 / 其他 — free-form, optional
  birthday  DateTime? // for age derivation + birthday surfacing
  region    String? // 地区 / city
  motto     String? // 人生信条 (separate from visionStatement which is the 10y arrow)

  // Vision layer
  visionStatement    String?
  coreValues         String  @default("[]") // JSON array<string>
  identityStatements String  @default("[]") // JSON array<string>

  // Equipped Title (Phase 3 cosmetic) — references Title.key, nullable.
  equippedTitleKey String?

  // Equipped avatar frame (Equipment slot) — references Equipment.key, nullable.
  equippedFrameKey String?

  // User preferences (theme, disabled modules, etc.)
  preferences String @default("{}") // JSON object

  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Gacha pity counters (Phase 3 §4.5)
  pullsSinceRare Int @default(0)
  pullsSinceEpic Int @default(0)
  totalPulls     Int @default(0)

  // Resin / 精力 — Genshin's 5-layer rhythm gate. Caps at 200, regenerates 1
  // per 8 minutes. Spent on AI Coach calls (decision/weekly/monthly).
  // Persisted as the LAST settled value at `resinUpdatedAt`; current value is
  // computed lazily by lib/resin.ts.
  resin          Int      @default(200)
  resinUpdatedAt DateTime @default(now())

  areas               Area[]
  tasks               Task[]
  habits              Habit[]
  routines            Routine[]
  xpEntries           XpLedger[]
  currency            Currency?
  financeAccounts     FinanceAccount[]
  financeCategories   FinanceCategory[]
  financeTransactions FinanceTransaction[]
  commissions         DailyCommission[]
  reviews             Review[]
  goals               Goal[]
  projects            Project[]
  rewards             RewardItem[]
  redemptions         RewardRedemption[]
  pulls               GachaPull[]
  unlocks             AchievementUnlock[]
  freezeStash         StreakFreeze?
  battlePasses        BattlePass[]
  principles          Principle[]
  decisions           Decision[]
  titles              UserTitle[]
  notes               Note[]
  eventClaims         UserEventClaim[]
  equipment           UserEquipment[]
  customAchievements  Achievement[]        @relation("UserCustomAchievements")
  customEvents        Event[]              @relation("UserCustomEvents")

  // Auth.js (next-auth v5) relations
  accounts Account[]
  sessions Session[]
}

// ============================================================
// Auth.js (next-auth v5) — required tables for OAuth + sessions
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String // "oauth" | "email" | "credentials"
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Layer 2: Life Areas (= gamified "departments" / attributes)
// ============================================================

model Area {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  icon        String @default("⭐")
  color       String @default("#8B5CF6")
  weight      Float  @default(1.0)
  healthScore Int    @default(50) // 0-100

  // Gamification attribute tag
  attributeKey String @default("INT") // STR | INT | CHA | WIS | CRE | GOLD
  attributeXp  Int    @default(0)

  order     Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks       Task[]
  habits      Habit[]
  routines    Routine[]
  goals       Goal[]
  projects    Project[]
  decisions   Decision[]
  linkedNotes Note[]

  @@index([userId])
}

// ============================================================
// Layer 5: Execution — Tasks / Habits / Routines
// ============================================================

model Task {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title    String
  notes    String?
  status   String    @default("TODO") // TODO | DONE | CANCELED
  priority Int       @default(2) // 1=high, 2=normal, 3=low
  dueDate  DateTime?

  xpReward   Int @default(10)
  goldReward Int @default(5)

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
}

model Habit {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  title     String
  notes     String?
  direction String  @default("positive") // positive | negative | both

  positiveCount Int @default(0)
  negativeCount Int @default(0)

  xpPerTick   Int @default(5)
  goldPerTick Int @default(2)

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticks HabitTick[]

  @@index([userId])
}

model HabitTick {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  direction String // "+" | "-"
  xpDelta   Int
  goldDelta Int
  createdAt DateTime @default(now())

  @@index([habitId, createdAt])
}

model Routine {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  title String
  notes String?

  // Days of week as JSON array of ints (0=Sun..6=Sat); default every day
  daysOfWeek String @default("[0,1,2,3,4,5,6]")

  xpReward   Int @default(15)
  goldReward Int @default(8)

  streakCurrent    Int @default(0)
  streakBest       Int @default(0)
  freezesAvailable Int @default(2) // Duolingo-style

  lastCompletedDate String? // YYYY-MM-DD

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions RoutineCompletion[]

  @@index([userId])
}

model RoutineCompletion {
  id        String   @id @default(cuid())
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD local
  createdAt DateTime @default(now())

  @@unique([routineId, date])
  @@index([routineId, date])
}

// ============================================================
// Gamification ledgers
// ============================================================

model XpLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  source    String // task | habit | routine | commission | review | bonus
  sourceId  String?
  areaKey   String? // which attribute gained XP (STR/INT/...)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Currency {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gold      Int      @default(0)
  gems      Int      @default(0)
  fate      Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum FinanceAccountType {
  cash
  bank
  wallet
  credit
  investment
  debt
  receivable
  virtual
}

enum FinanceTransactionType {
  income
  expense
  transfer
}

// ============================================================
// Finance Ledger — real-world accounts, categories, transactions
// ============================================================

model FinanceAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                String
  type                FinanceAccountType @default(cash)
  currencyCode        String             @default("CNY")
  initialBalanceCents Int                @default(0)
  balanceCents        Int                @default(0)
  includeInNetWorth   Boolean            @default(true)
  color               String             @default("#b68838")
  icon                String             @default("wallet")
  archived            Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outgoingTransactions FinanceTransaction[] @relation("FinanceSourceAccount")
  incomingTransactions FinanceTransaction[] @relation("FinanceTargetAccount")

  @@index([userId, archived])
  @@index([userId, type])
}

model FinanceCategory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name               String
  kind               FinanceTransactionType
  color              String                 @default("#b68838")
  monthlyBudgetCents Int                    @default(0)
  order              Int                    @default(0)
  archived           Boolean                @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions FinanceTransaction[]

  @@unique([userId, kind, name])
  @@index([userId, kind, archived])
}

model FinanceTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         FinanceTransactionType
  amountCents  Int
  currencyCode String                 @default("CNY")

  sourceAccountId String?
  sourceAccount   FinanceAccount?  @relation("FinanceSourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  targetAccountId String?
  targetAccount   FinanceAccount?  @relation("FinanceTargetAccount", fields: [targetAccountId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  payee      String?
  note       String?
  tags       String   @default("[]")
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, occurredAt])
  @@index([userId, type, occurredAt])
  @@index([sourceAccountId])
  @@index([targetAccountId])
  @@index([categoryId])
}

// ============================================================
// Daily Commissions (《原神》式日委托)
// ============================================================

model DailyCommission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String // YYYY-MM-DD local

  // Array of 4 items; each {sourceType: "task"|"habit"|"routine", sourceId, title, done, xp, gold, areaKey?}
  items String // JSON

  completedCount Int     @default(0)
  bonusClaimed   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// ============================================================
// Review Layer
// ============================================================

model Review {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String // daily | weekly | monthly | quarterly
  periodStart DateTime
  periodEnd   DateTime
  content     String // JSON — structure varies per kind
  mood        Int? // 1-10
  energy      Int? // 1-10
  focus       Int? // 1-10
  createdAt   DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// ============================================================
// Layer 3: Goals / OKRs
// ============================================================

model Goal {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  type       String   @default("okr") // okr | milestone
  objective  String
  notes      String?
  timeframe  String // e.g. "Q2-2026" | "Year-2026"
  startDate  DateTime
  endDate    DateTime
  status     String   @default("active") // active | done | paused | archived
  confidence Int      @default(5) // 1-10 weekly self-rating

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  keyResults  KeyResult[]
  projects    Project[]
  linkedNotes Note[]

  @@index([userId, status])
  @@index([userId, timeframe])
}

model KeyResult {
  id     String @id @default(cuid())
  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  description String
  unit        String? // tasks | hours | books | percent | custom
  target      Float
  current     Float   @default(0)
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goalId])
}

// ============================================================
// Layer 4: Projects (PARA-P)
// ============================================================

model Project {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  title       String
  deliverable String?
  notes       String?
  status      String    @default("active") // idea | active | paused | done | archived
  startDate   DateTime?
  deadline    DateTime?
  completedAt DateTime?

  xpReward   Int @default(100)
  goldReward Int @default(40)
  gemsReward Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks       Task[]
  linkedNotes Note[]

  @@index([userId, status])
}

// ============================================================
// Phase 3: Rewards Store (currency outlet)
// ============================================================

model RewardItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  emoji       String  @default("🎁")
  imageUrl    String? // optional user-uploaded image (overrides emoji visually in gacha + store)
  tier        String  @default("common") // common | rare | epic | legendary

  costGold Int @default(0)
  costGems Int @default(0)

  inGachaPool Boolean @default(true)
  weight      Int     @default(1) // gacha pool weight within tier

  redeemedCount Int     @default(0)
  archived      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions RewardRedemption[]
  pulls       GachaPull[]

  @@index([userId, tier])
}

model RewardRedemption {
  id       String     @id @default(cuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId String
  reward   RewardItem @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  costGold    Int       @default(0)
  costGems    Int       @default(0)
  source      String    @default("store") // store | gacha
  status      String    @default("available") // available | used | discarded
  usedAt      DateTime?
  discardedAt DateTime?
  note        String?
  redeemedAt  DateTime  @default(now())

  @@index([userId, redeemedAt])
  @@index([userId, status])
}

// ============================================================
// Phase 3: Achievements
// ============================================================

model Achievement {
  id          String  @id @default(cuid())
  // Global definitions when ownerUserId is null; per-user customs when set.
  key         String  @unique // "first_task" | "streak_7" | "u:cuid" for customs
  name        String
  description String
  emoji       String  @default("🏆")
  imageUrl    String? // optional user-uploaded image (overrides emoji visually)
  tier        String  @default("bronze") // bronze | silver | gold | legendary
  category    String  @default("milestone") // streak | cumulative | milestone | hidden | custom

  // Owner — null = system-seeded global, otherwise user-scoped custom.
  ownerUserId String?
  ownerUser   User?   @relation("UserCustomAchievements", fields: [ownerUserId], references: [id], onDelete: Cascade)

  // Trigger spec — interpreted by achievements engine.
  // Format: "<metric>:<threshold>" e.g. "task_done_count:10" "routine_streak:30"
  // For customs: "manual" allows manual-tick unlock (user marks as done).
  trigger    String
  hidden     Boolean @default(false)
  rewardGold Int     @default(0)
  rewardGems Int     @default(0)
  rewardFate Int     @default(0)

  unlocks AchievementUnlock[]

  @@index([category])
  @@index([ownerUserId])
}

model AchievementUnlock {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

// ============================================================
// Phase 3: Gacha pulls
// ============================================================

model GachaPull {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId String?
  reward   RewardItem? @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  tier      String // common | rare | epic | legendary
  fateSpent Int      @default(1)
  pity      String? // "soft" | "hard" — for analytics
  pulledAt  DateTime @default(now())

  @@index([userId, pulledAt])
}

// ============================================================
// Phase 3: Streak Freeze inventory
// ============================================================

model StreakFreeze {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  count     Int      @default(0)
  totalUsed Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ============================================================
// Phase 3: Weekly Battle Pass (per design §4.4)
// ============================================================

model BattlePass {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekStart String // YYYY-MM-DD (Monday) — local
  weekEnd   String // YYYY-MM-DD (Sunday) — local

  // Cached snapshot (recomputed on each load); persisted for history view
  totalXp Int @default(0)
  level   Int @default(0)

  // 8-10 missions, JSON array of { key, title, target, current, xpReward, area? }
  missions String @default("[]")

  // BP level rewards already claimed: JSON array<int>
  claimedLevels String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

// ============================================================
// Phase 4: Decision Engine — Principles Library + Decision Journal
// (Per design §1.4 Dalio Principles + Heath WRAP)
// ============================================================

model Principle {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  body     String // Full statement, can be multi-line
  source   String? // "Dalio" | "WRAP" | "personal" | book ref
  category String  @default("life") // life | decision | health | money | relationship | career
  emoji    String  @default("📜")

  usageCount Int      @default(0) // how many decisions cite this
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  citations DecisionPrinciple[]

  @@index([userId, archived])
}

model Decision {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  title   String
  context String // What's the situation
  status  String @default("open") // open | decided | reviewed
  stakes  String @default("medium") // low | medium | high

  // Options + EV — JSON array of {label, prob, payoff, penalty, ev, notes?}
  // prob in 0..1 (probability of payoff); penalty applied to (1-prob).
  options     String @default("[]")
  chosenIndex Int? // null until decided

  // WRAP / Pre-mortem support fields
  preMortem String? // What could go wrong
  tenTenTen String? // 10-min / 10-month / 10-year reflection

  decidedAt   DateTime?
  reviewDueAt DateTime? // when to come back

  // Post-mortem (filled at review time)
  outcome String?
  lessons String?
  rating  Int? // 1-10 retrospective decision quality

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewedAt DateTime?

  principles DecisionPrinciple[]

  @@index([userId, status])
  @@index([userId, reviewDueAt])
}

model DecisionPrinciple {
  decisionId  String
  decision    Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  principleId String
  principle   Principle @relation(fields: [principleId], references: [id], onDelete: Cascade)

  @@id([decisionId, principleId])
  @@index([principleId])
}

// ============================================================
// Phase 3 收尾: Titles (称号系统)
// Each title is a global definition unlocked by achieving a specific
// achievement (sourceAchievementKey). User can equip one at a time;
// shows in TopNav under the avatar pill.
// ============================================================

model Title {
  id                   String @id @default(cuid())
  key                  String @unique // stable identifier, used by User.equippedTitleKey
  name                 String // 显示名 — 称号本身（"晨型人"、"Dalio 门徒"）
  description          String // 一句解锁/含义说明
  emoji                String @default("🏷️")
  tier                 String @default("bronze") // bronze | silver | gold | legendary
  sourceAchievementKey String // FK by-key to Achievement.key

  unlocks UserTitle[]

  @@index([sourceAchievementKey])
  @@index([tier])
}

model UserTitle {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleKey   String // FK to Title.key
  title      Title    @relation(fields: [titleKey], references: [key], onDelete: Cascade)
  unlockedAt DateTime @default(now())

  @@unique([userId, titleKey])
  @@index([userId, unlockedAt])
}

// ============================================================
// Knowledge Base / 第二大脑 (PARA-R: Resources + Notes + Highlights)
// Per design doc §3 Knowledge Base layer.
// ============================================================

// ============================================================
// Phase 3 收尾: Events (限时活动) — Genshin 5-layer rhythm last layer
// ============================================================

model Event {
  id          String  @id @default(cuid())
  key         String  @unique // stable identifier for seed/upserts
  name        String
  description String
  emoji       String  @default("🎉")
  imageUrl    String? // optional user-uploaded banner image
  // Color theme for the banner (CSS color, e.g. "#9b6bc1")
  themeColor  String  @default("#b68838")

  // Owner — null = system-seeded, otherwise user-scoped custom event.
  ownerUserId String?
  ownerUser   User?   @relation("UserCustomEvents", fields: [ownerUserId], references: [id], onDelete: Cascade)

  startsAt DateTime
  endsAt   DateTime

  // Mission catalog — JSON array of {key, title, metric, target, xpReward, goldReward, gemsReward, fateReward, emoji}
  // metric values are checked at request time; missions complete once their counter reaches target.
  missions String @default("[]")

  // Bonus completion reward when ALL missions are claimed
  bonusXp           Int     @default(0)
  bonusGold         Int     @default(0)
  bonusGems         Int     @default(0)
  bonusFate         Int     @default(0)
  // Optional Equipment.key unlocked when all missions claimed
  bonusEquipmentKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims UserEventClaim[]

  @@index([startsAt, endsAt])
  @@index([ownerUserId])
}

model UserEventClaim {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  missionKey String // which mission within the event was claimed
  // Snapshot of the metric value at claim time (for analytics)
  snapshot   Int      @default(0)
  claimedAt  DateTime @default(now())

  @@unique([userId, eventId, missionKey])
  @@index([userId, eventId])
}

// ============================================================
// Phase 3 收尾: Equipment (装备/外观) — collection-oriented cosmetic slots
// Per design doc §4.1. v1 ships avatar-frame slot only; schema supports
// adding banner/badge/etc. slots later.
// ============================================================

model Equipment {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String
  emoji       String  @default("🖼️")
  slot        String  @default("frame") // frame | banner | badge (future)
  tier        String  @default("common") // common | rare | epic | legendary
  // Source how the user obtains it: achievement | event | gacha | seed
  source      String  @default("seed")
  sourceKey   String? // achievement key, event key, etc.
  // Visual style — JSON spec consumed by the frame renderer
  // {gradient: [c1, c2], strokeWidth, ornament, glow}
  style       String  @default("{}")

  unlocks UserEquipment[]

  @@index([slot, tier])
  @@index([sourceKey])
}

model UserEquipment {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipmentKey String
  equipment    Equipment @relation(fields: [equipmentKey], references: [key], onDelete: Cascade)
  unlockedAt   DateTime  @default(now())

  @@unique([userId, equipmentKey])
  @@index([userId, unlockedAt])
}

model Note {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional cross-links — a note can hang off any combination
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goalId    String?
  goal      Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)

  // What kind of note this is — drives icon + filter affordances.
  kind String @default("note") // note | highlight | quote | link | inspiration

  title       String
  body        String // markdown-friendly free text
  sourceUrl   String? // link out (article, book, video)
  sourceTitle String? // human-readable source label
  author      String? // book author, article writer, etc.

  // Free-form tags (comma-separated string for SQLite simplicity, parsed in code)
  tags String @default("")

  pinned   Boolean @default(false)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, archived])
  @@index([userId, kind])
  @@index([userId, areaId])
  @@index([userId, projectId])
  @@index([userId, goalId])
}
