{
  "name": "lifeos",
  "version": "0.1.0",
  "private": true,
  "description": "LifeOS — personal life operating system (PARA + GTD + OKR + gamified)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kunkun1234-1/lifeos.git"
  },
  "bugs": {
    "url": "https://github.com/Kunkun1234-1/lifeos/issues"
  },
  "homepage": "https://lifeos-topaz-chi.vercel.app",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:api": "node scripts/run-api.mjs dev",
    "build": "prisma generate && next build --turbopack",
    "build:api": "node scripts/run-api.mjs build",
    "postinstall": "prisma generate",
    "start": "next start",
    "start:api": "node scripts/run-api.mjs start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "node scripts/run-api.mjs typecheck",
    "verify:split": "npm run lint && npm run typecheck && npm run typecheck:api && npm run build && npm run build:api && npm run smoke:api",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:wallet": "node scripts/smoke-wallet.mjs",
    "smoke:notes": "node scripts/smoke-notes.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "test:store-wish": "tsx scripts/test-store-wish.ts",
    "test:schedule": "tsx scripts/test-schedule-model.ts",
    "verify:predeploy": "npm run verify:split && npm run smoke:notes",
    "db:generate": "prisma generate",
    "db:check": "node scripts/db-check.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@tanstack/react-query": "^5.59.0",
    "@tiptap/extension-image": "^3.29.0",
    "@tiptap/extension-link": "^3.29.0",
    "@tiptap/extension-placeholder": "^3.29.0",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@vercel/blob": "2.8.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.454.0",
    "nanoid": "^5.0.7",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^2.5.4",
    "tiptap-markdown": "^0.9.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tanstack/react-query-devtools": "^5.59.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "postcss": "^8.5.10",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
