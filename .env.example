## ────────────────────────────────────────────────────────────
## LifeOS — environment variables
## Copy to `.env` for local dev. For Vercel, paste these into the
## project's Environment Variables UI.
## ────────────────────────────────────────────────────────────

# Local dev should use a reachable Postgres database. Recommended:
# - local Postgres: postgresql://USER:PASSWORD@localhost:5432/lifeos_dev?schema=public
# - Neon dev branch: use the pooled URL from Neon, ending in -pooler...neon.tech
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeos_dev?schema=public"

# next-auth (Auth.js v5) — REQUIRED in production.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth — needed for production sign-in.
# Create at: https://console.cloud.google.com/ → APIs & Services → Credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Blob — set in Vercel Project → Storage → Connect Blob.
# Unset = /api/upload writes to public/uploads/ on disk (local dev / self-hosted).
# BLOB_READ_WRITE_TOKEN=""

# DeepSeek (AI Coach) — server-side only, do NOT expose.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
