## ────────────────────────────────────────────────────────────
## LifeOS — environment variables
## Copy to `.env` for local dev. For Vercel, paste these into the
## project's Environment Variables UI.
## ────────────────────────────────────────────────────────────

# Local dev should use a reachable Postgres database. Recommended:
# - local Postgres: postgresql://USER:PASSWORD@localhost:5432/lifeos_dev?schema=public
# - Neon dev branch: use the pooled URL from Neon, ending in -pooler...neon.tech
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeos_dev?schema=public"

# next-auth (Auth.js v5) — REQUIRED in production.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Independent backend API. Use the same random 32+ character value in both
# deployments. AUTH_SECRET is used as a fallback when this is omitted.
API_JWT_SECRET=""

# ChatGPT / MCP OAuth. Use the same 32+ character secret in Web and API.
# The issuer is the public Web origin; the resource is the exact public MCP URL.
MCP_OAUTH_SECRET=""
MCP_AUTH_ISSUER="http://localhost:3000"
MCP_RESOURCE_URL="http://127.0.0.1:4000/mcp"

# Browser-facing URL of the independent API. Required in production.
# Development defaults to http://127.0.0.1:4000.
# NEXT_PUBLIC_API_URL="http://127.0.0.1:4000"

# Allowed frontend origins for API CORS (comma-separated).
WEB_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Google OAuth — needed for production sign-in.
# Create at: https://console.cloud.google.com/ → APIs & Services → Credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Blob — set in Vercel Project → Storage → Connect Blob.
# Unset = /api/upload writes to public/uploads/ on disk (local dev / self-hosted).
# BLOB_READ_WRITE_TOKEN=""

# DeepSeek (AI Coach) — server-side only, do NOT expose.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
